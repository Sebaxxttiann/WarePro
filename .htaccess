# --- Ware-Pro ---
Options -Indexes
DirectoryIndex index.php

# Página 404 personalizada (ruta relativa: funciona en la raíz del dominio y en subcarpetas como /Warepro)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Archivos que nunca deben servirse por web: volcados SQL, respaldos, dependencias y configuración
    RewriteRule ^(database|backups|vendor)(/|$) - [F,L]
    RewriteRule (^|/)(composer\.(json|lock)|.*\.(sql|bak|log|env|md))$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# Compresión de texto: menos tráfico por cada página, JSON de workstations y librerías
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caché del navegador para archivos estáticos: no se vuelven a descargar en cada visita
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
